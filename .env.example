# Copy this file to .env and fill in your values.

# YouTube Data API v3 key — used ONLY for bulk video metadata (videos.list).
YOUTUBE_API_KEY=

# Bunny Stream (Dashboard → Stream → your library → API).
# Library ID is the numeric ID in the library URL/settings.
BUNNY_STREAM_LIBRARY_ID=
# Library API key from Stream → Library → API (NOT the account API key).
BUNNY_STREAM_API_KEY=
# Optional CDN hostname from Stream library details, e.g. vz-xxxx.b-cdn.net
# Used to build HLS playlist URLs. Embed/play URLs work without this.
# BUNNY_STREAM_CDN_HOSTNAME=

# Bunny Storage (Dashboard → Storage → your zone) for video/short/playlist thumbnails.
# Storage zone name (not pull zone).
BUNNY_STORAGE_ZONE=
# Storage zone password / FTP & API Access password.
BUNNY_STORAGE_PASSWORD=
# Region host, e.g. storage.bunnycdn.com or ny.storage.bunnycdn.com
# BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
# Pull Zone hostname that points at this storage zone, e.g. myzone.b-cdn.net
BUNNY_STORAGE_CDN_HOSTNAME=

# Root folder for THUMBNAILS in Bunny Storage only (not Stream video uploads).
# Encoded form also works: Kids%20Apps%2FVoD%20-%20Roku%20TV
BUNNY_ROOT_PATH=Kids Apps/VoD - Roku TV
# Creator folder key = YouTube handle (fallback: name), same for Stream + Storage.
# Thumbnails:
#   Kids Apps/VoD - Roku TV/{CreatorKey}/thumbnails/videos|shorts|playlists/...
# Stream video media (no BUNNY_ROOT_PATH):
#   {CreatorKey}/videos
#   {CreatorKey}/shorts
#   {CreatorKey}/playlists

# How many videos to upload at the same time when using `upload` alone.
UPLOAD_CONCURRENCY=3
# Combined transfer (download→upload→delete): how many videos in-flight at once.
# Keep low (2–3) if disk space is limited — each in-flight video needs local space.
TRANSFER_CONCURRENCY=2

# SQLite by default. You can switch to Postgres: postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///data/scraper.db

# Path to the Excel workbook (each sheet = category).
EXCEL_PATH=data/channels.xlsx

# Temp folder — each file is deleted immediately after Bunny upload.
DOWNLOAD_DIR=temp_downloads

# How many Popular long-form videos to keep per channel.
MAX_VIDEOS_PER_CHANNEL=100
# How many Shorts to keep per channel (Shorts tab).
MAX_SHORTS_PER_CHANNEL=50
# Drop "shorts" longer than this (seconds). Real YouTube Shorts are ≤180s.
# Longer rows are usually long-form videos mis-labeled from /shorts scrape.
MAX_SHORT_DURATION_SECONDS=180
# How many playlists to keep per channel (Data API).
MAX_PLAYLISTS_PER_CHANNEL=10
# Max videos to pull from each playlist (kids channels often have 1000+).
MAX_PLAYLIST_ITEMS=100

# Optional: single Netscape cookies.txt for yt-dlp.
# YTDLP_COOKIES=data/cookies.txt
# Recommended: folder of multiple cookie files — auto-rotates when rate-limited.
# Export each Google account once (browser extension → cookies.txt), e.g.:
#   data/cookies/account1.txt
#   data/cookies/account2.txt
#   data/cookies/account3.txt
# YTDLP_COOKIES_DIR=data/cookies
# Optional: pull cookies from a local browser instead. Examples: chrome, edge, firefox
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Pause between finished downloads (serialized under the hood). Raise if rate-limited.
DOWNLOAD_DELAY_SECONDS=8
# yt-dlp sleeps: before each download, and between page/API requests.
YTDLP_SLEEP_INTERVAL=5
YTDLP_SLEEP_REQUESTS=1.5
# When YouTube rate-limits: pause this many seconds, rotate cookie, retry.
RATE_LIMIT_COOLDOWN_SECONDS=3700
# After this many cooldown/rotate cycles, abort the run (rows stay pending).
RATE_LIMIT_MAX_COOLDOWNS=3
# How many times to retry a single video on 403/timeouts (not rate-limit).
DOWNLOAD_RETRIES=3

# Keep transfer concurrency low — downloads are serialized anyway; this mainly
# overlaps Bunny upload with the next download.
TRANSFER_CONCURRENCY=1

# JS runtime for YouTube downloads. Leave empty to auto-detect Deno, then Node.
# Examples: deno   or   deno:C:\path\to\deno.exe   or   node
# YTDLP_JS_RUNTIMES=deno

# Optional absolute path to ffmpeg.exe if it is not on PATH.
# FFMPEG_LOCATION=C:\path\to\ffmpeg.exe

# Target download quality (1080, 1080p, 1440, 4k). Prefer 1080p when available.
YTDLP_MAX_HEIGHT=1080
# Reject and retry if download is below this (stops silent 360p / format-18).
YTDLP_MIN_HEIGHT=720
# Optional client override (comma-separated). Default with cookies: web_safari,mweb,web
# Do NOT put tv first with cookies — often DRM → only 360p left.
# YTDLP_PLAYER_CLIENTS=web_safari,mweb,web
# Override format if needed. Default picks best video + English audio when available
# (falls back to original/best audio), then remuxes to mp4.
# YTDLP_FORMAT=bv*+ba/b
